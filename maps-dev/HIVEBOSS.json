 "scenery": [],
 "intro": {
  "title": "THE HIVE CANTOR",
  "lines": [
   "A bowl of seats, sixteen singers, one conductor over the podium.",
   "The real rules: you can die, ammunition runs out. Retry restarts the whole arena."
  ]
 },
 "messages": [
  {
   "id": "start",
   "at": [9, 28],
   "radius": 6,
   "speaker": "HULL",
   "text": "THE HIVE CANTOR (dev). Caches here and on the top tier. The beat is the pulse under everything: the singers act on it, the floors bloom on it, the conductor rings on it."
  },
  {
   "id": "gate",
   "at": [36, 28],
   "radius": 3,
   "speaker": "HULL",
   "text": "16 singers; the conductor takes 5% while they sing. A tier glows pink before it blooms. Its ring is low: any tier clears it, or hide behind a block."
  },
  {
   "id": "ring",
   "at": [42, 28],
   "radius": 4,
   "speaker": "HULL",
   "text": "The baton rises a beat before the ring; it goes out, turns, and comes home. Stand a metre up on a tier, or behind a block or pillar. A half-step is too low."
  },
  {
   "id": "half",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "Half its strength gone or the choir silent: a ring every bar now, and Choristers from the dome. The beat is gone from nothing yet: end it."
  },
  {
   "id": "dead",
   "at": [2, 2],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The conductor is down and the beat has stopped. The lights hold still. East of the podium the corridor is open."
  }
 ],
