 "intro": {
  "title": "THE TRAINING YARD",
  "lines": [
   "Ten rooms. Each door opens when you have done what the room asks.",
   "You cannot die here. {key:pause} leaves whenever you like."
  ]
 },
 "messages": [
  {
   "id": "s0",
   "at": [3, 9],
   "radius": 3,
   "speaker": "THE YARD",
   "text": "{key:forward} {key:left} {key:back} {key:right} to walk, the mouse to look. Walk to the far end."
  },
  {
   "id": "walked",
   "at": [13, 9],
   "radius": 3,
   "speaker": "THE YARD",
   "text": "The door has opened. A door with no handle answers to something you did somewhere else."
  },
  {
   "id": "s1",
   "at": [17, 9],
   "radius": 3,
   "speaker": "THE YARD",
   "text": "Hold {key:sprint} to run. The gun comes down while you run: you cannot fire until you let go and it comes back up."
  },
  {
   "id": "s2",
   "at": [31, 9],
   "radius": 3,
   "speaker": "THE YARD",
   "text": "Hold {key:aim} for the sights: slower on your feet, steadier on the target, and spread grows when you move. Kill the far one with {key:fire}."
  },
  {
   "id": "s3",
   "at": [45, 9],
   "radius": 3,
   "speaker": "THE YARD",
   "text": "{key:weapon2} is the scattergun. Wait until it is close and lifts its arm: a close hit knocks it out of its swing."
  },
  {
   "id": "s4",
   "at": [59, 9],
   "radius": 3,
   "speaker": "THE YARD",
   "text": "{key:weapon6} is your fists. Hold {key:aim} to guard. Raise it just as the blow lands and it is a parry: the next blow of yours hits twice as hard."
  },
  {
   "id": "s5",
   "at": [73, 9],
   "radius": 3,
   "speaker": "THE YARD",
   "text": "{key:weapon5} is the lamp. Tap for an arc that finds its own targets. Hold {key:fire} to charge, and let go."
  },
  {
   "id": "s6",
   "at": [87, 9],
   "radius": 3,
   "speaker": "THE YARD",
   "text": "A gun can carry a load. {key:load} turns it to the next one: slag burns, rime chills, penetrators go through plate. A load is found, not given: here they are free."
  },
  {
   "id": "s7",
   "at": [101, 9],
   "radius": 3,
   "speaker": "THE YARD",
   "text": "Dark. {key:lamp} lights the lantern. Oil runs out, and what hunts by light will see you."
  },
  {
   "id": "s8",
   "at": [115, 9],
   "radius": 3,
   "speaker": "THE YARD",
   "text": "Tap {key:weaponLast} for your last gun. Hold it for the wheel: time slows while it is open, and you let go on the gun you want."
  },
  {
   "id": "s9",
   "at": [129, 9],
   "radius": 3,
   "speaker": "THE YARD",
   "text": "{key:map} opens the Journal: the map, what you have read, what each thing you pick up is for. It stops the clock. That is everything. The way out is ahead."
  }
 ],
