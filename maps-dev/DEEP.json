 "intro": {
  "title": "THE DEEP RANGE",
  "lines": [
   "Dark. L lights the lantern; the oil is on the HUD.",
   "Zealots, chimes and a cave made by the cave kit. You cannot die."
  ]
 },
 "messages": [
  {
   "id": "hall",
   "at": [12, 60],
   "radius": 6,
   "speaker": "RANGE",
   "text": "DEEP RANGE. Dark: L lights the lantern (OIL on the HUD). Gaunts, Gills, Zealots see you from 6 m dark, 24 m lit. Tollbearers and Bellhands follow the Hush and ignore light."
  },
  {
   "id": "tunnel",
   "at": [30, 49],
   "radius": 6,
   "speaker": "RANGE",
   "text": "TUNNEL: oil tins on the road (+30). Three Gaunts and a Tollbearer asleep: with the lantern out the Gaunts stay asleep until you are 6 m off; the Tollbearer wakes by itself."
  },
  {
   "id": "grotto",
   "at": [56, 34],
   "radius": 8,
   "speaker": "RANGE",
   "text": "SONGKEEPER YARD (dark): two sponge Zealots (front, back) and three sleepers. A lance thrusts from 3.5 m after it dips; a hit GRAFTS: you walk slower for three seconds."
  },
  {
   "id": "bowl",
   "at": [26, 18],
   "radius": 8,
   "speaker": "RANGE",
   "text": "THE BOWL: five terraces going down, made by the cave kit; a stair is cut through every ring (two of them): each ring is a cliff elsewhere. Gills sleep on the terraces."
  },
  {
   "id": "grove",
   "at": [72, 60],
