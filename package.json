{
  "name": "hushfall",
  "version": "1.0.0",
  "description": "HUSHFALL - original browser FPS (Three.js runtime; p5/p5.brush are build-time baking tools only)",
  "scripts": {
    "bake": "node tools/bake.mjs",
    "validate": "node tools/validate.mjs",
    "status": "node tools/validate.mjs --status",
    "look": "vite --port 5173",
    "dev": "vite --port 5173",
    "shoot": "node tools/dev/shoot-look.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "build": "vite build",
    "verify": "npm run validate && npm test && npm run build",
    "browsercheck": "node tools/dev/browser-check.mjs",
    "verify-map": "node tools/verify-map.mjs",
    "shoot-stances": "node tools/dev/shoot-stances.mjs",
    "audio-qa": "node tools/dev/audio-qa.mjs",
    "shoot-weapons": "node tools/dev/shoot-weapons.mjs",
    "shoot-level": "node tools/dev/shoot-level.mjs",
    "gate1-bundle": "node tools/gate1-bundle.mjs",
    "gate2-bundle": "node tools/gate2-bundle.mjs",
    "build-map": "node tools/mapkit/compile.mjs",
    "mapview": "node tools/mapkit/mapview.mjs",
    "shoot-map": "node tools/dev/shoot-map.mjs",
    "render-ground": "node tools/dev/render-ground.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "p5": "2.3.4",
    "p5.brush": "2.2.3",
    "pngjs": "7.0.0",
    "puppeteer": "25.12.0",
    "vite": "8.3.1"
  },
  "private": true
}
