 "scenery": [],
 "par": {
  "time": 540
 },
 "intro": {
  "title": "UNDERCANTOR HALLS",
  "lines": [
   "A palace in two halves, and one seat between them.",
   "The west wing keeps the count. The east wing keeps the ones who will not."
  ]
 },
 "outro": "The seat is empty. The stair behind it goes down, and whichever way you came, someone in this house will tell the next what you did.",
 "messages": [
  {
   "id": "start",
   "at": [37, 63],
   "radius": 4,
   "speaker": "INES",
   "text": "A hall of cold marble with bronze bands, and a stair as wide as a slipway. Nobody on it. Somebody has swept it."
  },
  {
   "id": "plate-w",
   "at": [37, 51],
   "radius": 3,
   "speaker": "RINGING PLATE",
   "text": "West: the count is kept here. East: those who are not counted. The plate offers no third door."
  },
  {
   "id": "hub",
   "at": [37, 46],
   "radius": 4,
   "speaker": "HULL",
   "text": "The wings meet at the seat in the north. The west gate opens when the two captains are dead. The east gate is on a sound-lock and opens for someone who has been quiet."
  },
  {
   "id": "gallery",
   "at": [17, 40],
   "radius": 4,
   "speaker": "INES",
   "text": "Spears in ranks down a red carpet, all of them looking at the door I am standing in. Somebody knew somebody would come this way."
  },
  {
   "id": "plate-c",
   "at": [17, 16],
   "radius": 3,
   "speaker": "RINGING PLATE",
   "text": "Run a nail down it: the ranks are numbered, and the number of the dead is cut into the same plate, in the same hand, a little lower."
  },
  {
   "id": "captains",
   "at": [17, 12],
   "radius": 4,
   "speaker": "INES",
   "text": "Two on the dais, standing very still, and a gate in the wall behind them. The gate is the only door in the room that is not a way out."
  },
  {
   "id": "low",
   "at": [52, 40],
   "radius": 4,
   "speaker": "INES",
   "text": "It is darker here, and it smells of oil and a cold hearth. Rooms like bowls, one after another, and a lantern in each, turned low."
  },
  {
   "id": "silent1",
   "at": [51, 32],
   "radius": 3,
   "speaker": "A SILENT",
   "text": "I stopped singing the day the count was read. They have not asked me again. We are kept here because we are not worth the stair."
  },
  {
   "id": "silent2",
   "at": [61, 25],
   "radius": 3,
   "speaker": "A SILENT",
   "text": "Put down the gun in the rooms ahead. The gate at the end listens, and I do not think it listens for you."
  },
  {
   "id": "silent3",
   "at": [52, 17],
   "radius": 3,
   "speaker": "A SILENT",
   "text": "You are the one with no ear for it. We heard. Nobody here will ring for you, and nobody will stop you."
  },
  {
   "id": "hollow",
   "at": [65, 24],
   "radius": 2,
   "speaker": "HULL",
   "text": "The east wall of the far room rings hollow behind the lantern."
  },
  {
   "id": "cell",
   "at": [68, 24],
   "radius": 2,
   "speaker": "A SILENT (NOTE)",
   "text": "Four tins, a pair of boots and a cloak. Left for whoever the Marrow crew sent after them. They did not come this way."
  },
  {
   "id": "split",
   "at": [48, 33],
   "radius": 2,
   "speaker": "INES",
   "text": "The west wall of this room has cracked across, and someone has pushed a rag into the crack to keep the draught out."
  },
  {
   "id": "kept",
   "at": [44, 33],
   "radius": 1.5,
   "speaker": "INES",
   "text": "A store behind the crack: harpoon bolts with hard heads, and a mend. The Silent keep them and will not use them."
  },
  {
   "id": "seat",
   "at": [37, 8],
   "radius": 5,
   "speaker": "INES",
   "text": "The seat is a stone chair on a dais, and the stone is worn at the arms. It has been sat in a long time. Not today."
  },
  {
   "id": "chair",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The arm of the chair is a lever. Whoever sits here decides who goes down, and the stair was cut for a long line of them."
  },
  {
   "id": "open-w",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The west gate has opened. It was held by the captains, not by a lock."
  },
  {
   "id": "keyhunt",
   "at": [28, 3],
   "radius": 3,
   "speaker": "INES",
   "text": "A key on a choir lanyard. The name stitched on it is one of ours, in their hand."
  }
 ],
 "objective": "Climb the grand stair to the colonnade. Two wings lead to the seat: the west is the Songkeepers, the east is the Silent",
