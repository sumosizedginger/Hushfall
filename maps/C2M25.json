 "par": {
  "time": 540
 },
 "intro": {
  "title": "ROOT BELL DESCENT",
  "lines": [
   "A well thirty metres deep, in six landings.",
   "The way down is across the dark."
  ]
 },
 "outro": "The last landing is a root floor with an open door in the wall. The corridor beyond goes on down at the slope of the rest of the country, towards a sound that is not a sound yet.",
 "messages": [
  {
   "id": "start",
   "at": [68, 56],
   "radius": 5,
   "speaker": "INES",
   "text": "A well, and a floor at the bottom of it I can see from here, a long way down, by its own copper light. I count six ledges between me and it, and I count thirty metres."
  },
  {
   "id": "vent",
   "at": [63, 58],
   "radius": 5,
   "speaker": "HULL",
   "text": "The plate at the end of each ledge throws you across the well to the next. It is lit. There is no other way down but a fall."
  },
  {
   "id": "niche",
   "at": [8, 58],
   "radius": 4,
   "speaker": "A SILENT (NOTE)",
   "text": "A lit lamp holds the sound back. Keep it lit when the rings come. It is seen from far off, and the oil is what is in the tins here."
  },
  {
   "id": "rings",
   "at": [11, 29],
   "radius": 6,
   "speaker": "HULL",
   "text": "The Resonant on this ledge rings on nothing now: the beat is gone, and it rings when something stands near it. A lit lantern cuts what reaches you to three-fifths."
  },
  {
   "id": "door-lever",
   "at": [68, 17],
   "radius": 5,
   "speaker": "HULL",
   "text": "The lever on the wall by the last ledge opens the door to the north. Its lamp is lit."
  },
  {
   "id": "door-shut",
   "at": [66, 10],
   "radius": 4,
   "speaker": "HULL",
   "text": "The door to the north is shut. It opens to the lever on the wall of this ledge, beside the lantern.",
   "unless": [
    "msg:door-open"
   ]
  },
  {
   "id": "door-open",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The door has gone back into the wall. The corridor beyond it slopes down."
  },
  {
   "id": "seam",
   "at": [60, 9],
   "radius": 3,
   "speaker": "HULL",
   "text": "The outer wall of the last ledge rings hollow in one short run. There is a seam in the root."
  },
  {
   "id": "cache",
   "at": [60, 6],
   "radius": 3,
   "speaker": "A SILENT (NOTE)",
   "text": "This is what I could carry down. I counted the ledges on the way: six, and I stopped counting after that."
  }
 ],
