 "intro": {
  "title": "GATEKEEPER'S APPROACH",
  "lines": [
   "Everything the Vael had left is standing in this hall.",
   "The Gate is at the far end, and it is very bright."
  ]
 },
 "outro": "The hall opens. Above the last steps the light stops being a rumour and becomes a thing you can look at.",
 "messages": [
  {
   "id": "start",
   "at": [45, 108],
   "radius": 3,
   "speaker": "SIGNAL HOUSE",
   "text": "Calder, the Approach. Five ranks, each a step higher, each with its own guard. The gaps in the screens do not line up. The tunnels in the flanks go round the first two."
  },
  {
   "id": "court",
   "at": [45, 100],
   "radius": 4,
   "speaker": "INES",
   "text": "Shell-backs at the gaps. Walk round them or use something that goes through. The sky is the Gate. It is like looking at the sun."
  },
  {
   "id": "stalls",
   "at": [45, 85],
   "radius": 4,
   "speaker": "SIGNAL HOUSE",
   "text": "The stalls. A tall one with the wheel, and singers behind. Kill the wheel first. Everything near it takes half."
  },
  {
   "id": "mother",
   "at": [25, 62],
   "radius": 4,
   "speaker": "INES",
   "text": "She is in there, in the round room west of the rank. The way out stays locked as long as she weeps. Walk out of what she makes."
  },
  {
   "id": "steps",
   "at": [45, 50],
   "radius": 4,
   "speaker": "HULL",
   "text": "The steps. Two grafts with plates on their fronts, and bellhands behind them. Pillars are cover from the bells."
  },
  {
   "id": "last",
   "at": [45, 30],
   "radius": 4,
   "speaker": "INES",
   "text": "One more shell. Then the yard, and the Gate beyond it. I can feel it in my teeth."
  },
  {
   "id": "panel",
   "at": [79, 99],
   "radius": 3,
   "speaker": "HULL",
   "text": "The wall of the east tunnel rings hollow."
  }
 ],
