 "intro": {
  "title": "GATEKEEPER'S APPROACH",
  "lines": [
   "Everything the Vael had left is standing in this hall.",
   "The Gate is at the far end, and it is very bright."
  ]
 },
 "outro": "The hall opens. Above the last steps the glare gathers into a shape.",
 "messages": [
  {
   "id": "start",
   "at": [45, 108],
   "radius": 3,
   "speaker": "SIGNAL HOUSE",
   "text": "Five ranks, Calder, each a step higher. The gaps in the screens don't line up. The tunnels in the flanks go round the first two."
  },
  {
   "id": "court",
   "at": [45, 103],
   "radius": 4,
   "speaker": "INES",
   "text": "Shell-backs at the gaps. Walk round them or use something that goes through. The sky is the Gate. It's like looking at the sun."
  },
  {
   "id": "stalls",
   "at": [45, 85],
   "radius": 4,
   "speaker": "INES",
   "text": "The stalls. The tall one with the wheel is behind the singers."
  },
  {
   "id": "mother",
   "at": [25, 62],
   "radius": 4,
   "speaker": "INES",
   "text": "She is in there, in the round room west of the rank. The way out stays locked as long as she weeps. Walk out of what she makes."
  },
  {
   "id": "steps",
   "at": [45, 50],
   "radius": 4,
   "speaker": "HULL",
   "text": "The steps. Two grafts with plates on their fronts, and bellhands behind them. Pillars are cover from the bells."
  },
  {
   "id": "last",
   "at": [45, 30],
   "radius": 4,
   "speaker": "INES",
   "text": "One more shell. Then the yard, and the Gate beyond it. I can feel it in my teeth."
  },
  {
   "id": "panel",
   "at": [69, 100],
   "radius": 3,
   "speaker": "HULL",
   "text": "The wall of the east tunnel rings hollow."
  },
  {
   "id": "lock",
   "at": [50, 49],
   "radius": 5.5,
   "speaker": "HULL",
   "text": "A service lock in the east wall. Its inner door and its outer door will not stand open together. The hatch at the far end of it is open to the dark."
  }
 ],
