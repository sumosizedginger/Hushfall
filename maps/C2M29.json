 "intro": {
  "title": "THE ROOT BELL",
  "lines": [
   "The deep stone's last voice, hung at the bottom of the world on a chain.",
   "The Songkeepers ring it by hand to keep the Gate open. It cannot be broken. It can be made to stop."
  ]
 },
 "outro": "Above the bell the shaft goes up into a dark that the stair lights, one flight at a time.",
 "messages": [
  {
   "id": "start",
   "at": [12, 42],
   "radius": 6,
   "speaker": "HULL",
   "text": "Every weapon is on you. The ammunition boxes are here and on the top tier. Oil on the road, a mortar in four places on the rim. A lit lantern cuts a ring to three-fifths."
  },
  {
   "id": "gate",
   "at": [29, 42],
   "radius": 3,
   "speaker": "HULL",
   "text": "A bell with its heart on a chain. It swings: lead it. Four root anchors on the tier below the pillars hold the chain; while one stands it takes three tenths of a hit."
  },
