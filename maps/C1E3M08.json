 "intro": {
  "title": "THE CANTOR'S THROAT",
  "lines": [
   "Every note the Choir ever sang came out of this room.",
   "Something is about to sing the last one."
  ]
 },
 "outro": "Episode three is done. The Choir ships fall silent. Whatever they were calling, it heard.",
 "messages": [
  {
   "id": "start",
   "at": [5, 28],
   "radius": 3,
   "speaker": "SIGNAL HOUSE",
   "text": "Calder, the Throat. Every ship in the fleet sings through this chamber. Whatever sings it is at the far end, and I read four reeds feeding it. Cut the reeds first."
  },
  {
   "id": "gullet",
   "at": [17, 28],
   "radius": 3,
   "speaker": "INES",
   "text": "It is wet. The walls are wet. Do not think about what the walls are."
  },
  {
   "id": "ribs",
   "at": [28, 28],
   "radius": 3,
   "speaker": "HULL",
   "text": "Ribs, four of them, one wall to the other with a gap on alternate sides. It is a bend in a throat. They will be waiting at every gap."
  },
  {
   "id": "singers",
   "at": [38, 28],
   "radius": 3,
   "speaker": "INES",
   "text": "Singers in the curve. A shell-back in front of them. Kill the tall one with the wheel first: everything near it takes half."
  },
  {
   "id": "bell",
   "at": [47, 24],
   "radius": 3,
   "speaker": "SIGNAL HOUSE",
   "text": "There. Four-legged, a horn the size of a doorway. Shielded while the four reeds sing. Pillars are cover from the rings. It sings two. Wait for the second."
  },
  {
   "id": "panel",
   "at": [17, 27],
   "radius": 2,
   "speaker": "HULL",
   "text": "The panel in the gullet's south wall rings hollow."
  },
  {
   "id": "shield",
   "at": [57, 28],
   "radius": 0.1,
   "speaker": "INES",
   "text": "The reeds are silent. The shield is gone. Hit it with everything."
  },
  {
   "id": "broken",
   "at": [57, 8],
   "radius": 3,
   "speaker": "SIGNAL HOUSE",
   "text": "The voice is gone, Calder. The ships are quiet. Whatever they were calling heard that. We should not be here when it answers."
  }
