 "par": {
  "time": 420
 },
 "intro": {
  "title": "CHOIR OF ONE",
  "lines": [
   "A bowl of seats, nine singers, one conductor over the podium.",
   "Everything in the Hive keeps time to it."
  ]
 },
 "outro": "The conductor stopped in the middle of a bar and the lights on the ribs went still. For the first time in this country nothing is keeping time.",
 "messages": [
  {
   "id": "start",
   "at": [9, 28],
   "radius": 6,
   "speaker": "INES",
   "text": "A long hall with every box I could want in it, laid out in two rows, as if somebody expected a person to come and take them. Somebody has."
  },
  {
   "id": "plate",
   "at": [36, 28],
   "radius": 3,
   "speaker": "COUNT PLATE",
   "text": "OWED 52,310. SUNG 49,715. SHORT 2,595. It is the same plate as the one at the first fire-base, and the sum has not moved."
  },
  {
   "id": "gate",
   "at": [40, 28],
   "radius": 4,
   "speaker": "HULL",
   "text": "Nine singers in three tiers. The conductor takes a twentieth of a hit while they sing, and more with every one that falls. A tier lights before it blooms."
  },
  {
   "id": "ring",
   "at": [42, 28],
   "radius": 4,
   "speaker": "HULL",
   "text": "The baton rises a beat before the ring. It goes out, turns, and comes home. Stand a metre up on a tier, or behind a block or a pillar. A half-step is too low."
  },
  {
   "id": "half",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "Half its strength gone, or the choir silent: a ring every bar now, and Choristers from the dome."
  },
  {
   "id": "dead",
   "at": [2, 2],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The conductor is down and the beat has stopped. The lights hold still. East of the podium the corridor is open."
  },
  {
   "id": "hollow",
   "at": [48, 15],
   "radius": 3,
   "speaker": "HULL",
   "text": "The wall of the top tier rings hollow behind the north pillar. There is a seam in it."
  },
  {
   "id": "alcove",
   "at": [48, 10],
   "radius": 3,
   "speaker": "A SILENT (NOTE)",
   "text": "A conductor sits down between movements. This was the chair. Whoever it was is not on the podium now, and the baton is on the podium."
  },
  {
   "id": "exit",
   "at": [72, 28],
   "radius": 3,
   "speaker": "INES",
   "text": "A corridor, straight, at the height of the top tier. At the far end the air is cold, and nothing in it is keeping time."
  }
 ],
