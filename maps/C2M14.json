 "intro": {
  "title": "HARMONIC GARDENS",
  "lines": [
   "A garden laid out on a spiral, and a tree in the middle of it.",
   "Every plant in it was grown to ring."
  ]
 },
 "outro": "The third wall opens on a stair. Behind you the garden is still ringing, very faintly, in a chord you did not play.",
 "messages": [
  {
   "id": "start",
   "at": [48, 92],
   "radius": 4,
   "speaker": "INES",
   "text": "Stone beds on a spiral, each one a little further round than the last. Whoever laid it out did not use a line or a plumb. They used a count."
  },
  {
   "id": "harvest",
   "at": [48, 78],
   "radius": 5,
   "speaker": "INES",
   "text": "Spearmen in green walking the beds with long hooks, picking."
  },
  {
   "id": "plate",
   "at": [48, 70],
   "radius": 3,
   "speaker": "RINGING PLATE",
   "text": "Run a nail down it: five plants, five notes. A gardener grows one for each, and lays the bed so that a tone from one strikes the next."
  },
  {
   "id": "tree",
   "at": [48, 60],
   "radius": 5,
   "speaker": "HULL",
   "text": "The tree in the middle plays a phrase when you use it: the fruit light in order, a note each. Answer on the chimes, in order, each within eight seconds of the last."
  },
  {
   "id": "avenue",
   "at": [48, 38],
   "radius": 4,
   "speaker": "HULL",
   "text": "Three walls across the avenue to the north. The tree plays the next phrase that is not yet answered. A wrong note starts the phrase again."
  },
  {
   "id": "r1",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "INES",
   "text": "Three notes, and the first wall has gone back into its bed. It folded. Like a hedge in a wind."
