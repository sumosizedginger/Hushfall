 "par": {
  "time": 420
 },
 "intro": {
  "title": "BELLWRIGHT YARD",
  "lines": [
   "The Vael do not cast their bells. They grow them.",
   "Every one of these is waiting for someone."
  ]
 },
 "outro": "Next: the Threshold Ascent, a city built up a cliff of glass, and the shaft in the middle of it.",
 "messages": [
  {
   "id": "start",
   "at": [6, 56],
   "radius": 3,
   "speaker": "INES",
   "text": "A yard round a kiln. Long sheds, a coal yard, a tower on a terrace, and a furnace the size of a house. The air tastes of hot metal."
  },
  {
   "id": "seeds",
   "at": [22, 47],
   "radius": 3,
   "speaker": "INES",
   "text": "Bells on stands in the shed, green with new bronze, ringing very faintly. They weren't cast. Each is for somebody who hasn't been brought here yet."
  },
  {
   "id": "forks",
   "at": [27, 44],
   "radius": 3,
   "speaker": "HULL",
   "text": "Forks stand at every shed door. A bell broken with a rifle rings them, and the yard hears. A blow, the arc lamp and the tuning-fork gun are quieter."
  },
  {
   "id": "tally",
   "at": [6, 28],
   "radius": 2.5,
   "speaker": "BELLWRIGHT'S TALLY",
   "text": "THE MARROW ORDER. 311 BELLS GROWN. 311 HUNG. FOUR SPARE."
  },
  {
   "id": "hollow",
   "at": [6, 23],
   "radius": 2,
   "speaker": "HULL",
   "text": "The north wall of the west shed rings hollow."
  },
  {
   "id": "gate",
   "at": [19, 6],
   "radius": 3,
   "speaker": "HULL",
   "text": "The yard gate, in the corner of the coal yard. It is barred, and the bar is worked from the kiln house."
  },
  {
   "id": "ripening",
   "at": [0, 0],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "A bell in one of the sheds has begun to ring louder. When it cracks, a bell-bearer steps out of it. Break it first."
  },
  {
   "id": "cracked",
   "at": [0, 0],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "A bell cracks, and something steps out of it."
  },
  {
   "id": "kiln",
   "at": [36, 29],
   "radius": 3,
   "speaker": "INES",
   "text": "The furnace is banked with salt, not out. The lever on the kiln house wall is the only thing in here that isn't hot."
  },
  {
   "id": "quench",
   "at": [0, 0],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The lever drops. Out in the coal yard, the bar falls out of the gate."
  },
  {
   "id": "split",
   "at": [61, 28],
   "radius": 2,
   "speaker": "INES",
   "text": "The back wall of this shed has split, and warm air comes through the split. A shot would bring it down."
  },
  {
   "id": "spare",
   "at": [65, 28],
   "radius": 1.5,
   "speaker": "INES",
   "text": "A bellwright's cupboard: carbine rounds with hard tips, a vest, and a small bell with no name in it yet."
  },
  {
   "id": "keyhunt",
   "at": [17, 19],
   "radius": 3,
   "speaker": "INES",
   "text": "The quench lever's brass pin, hung well away from the lever. Someone did not want it thrown in a hurry."
  }
 ],
 "objective": "The kiln house and its lever unbar the yard gate in the coal yard. Break the bells before they crack",
