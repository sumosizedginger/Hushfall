 },
 "intro": {
  "title": "FAULT LINE",
  "lines": [
   "The stone has cracked from end to end, and the crack is lit from below.",
   "Three-quarters of a minute from now the road begins to fall, from the west."
  ]
 },
 "outro": "The last lip held. Behind it the front went on along the road to the end of the world and fell into the glow without a sound, and the glow went on.",
 "messages": [
  {
   "id": "start",
   "at": [6, 8],
   "radius": 5,
   "speaker": "INES",
   "text": "The stone is cold, and from the crack comes a light the colour of a forge. The whole country has cracked along one line, and the crack is as wide as a harbour mouth."
  },
  {
   "id": "front",
   "at": [14, 8],
   "radius": 5,
   "speaker": "HULL",
   "text": "Forty-five seconds after you arrive the road starts to fall from the west end, a strip at a time, a metre a second. A strip falls three times; the view shakes first. Stay ahead."
  },
  {
   "id": "noise",
   "at": [26, 8],
   "radius": 5,
   "speaker": "HULL",
   "text": "Everything on these roads is asleep. A loud gun wakes whatever stands inside the ring on the readout, and the front is behind you. A quiet one passes."
  },
  {
   "id": "bridge",
   "at": [38, 10],
   "radius": 5,
   "speaker": "HULL",
   "text": "The north road is broken in the middle. The first bridge is the way across: it sinks half a metre after you cross, and a stair on the far side climbs out of the pit."
  },
  {
   "id": "south",
   "at": [50, 31],
   "radius": 5,
   "speaker": "INES",
   "text": "The south road goes on in the same grey and the same cold. Somebody has laid lamps along it. The stone that's going hasn't reached this far yet."
  },
  {
   "id": "lip",
   "at": [96, 9],
   "radius": 5,
   "speaker": "HULL",
   "text": "The lever on the far lip is on the north wall of the road, under two lamps and a lantern. It holds the lip. The exit is locked until it is thrown."
  },
  {
   "id": "far-lip",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The lip is held. The exit has come unlocked at the east end of the road."
  },
  {
   "id": "exit",
   "at": [118, 8],
   "radius": 4,
   "speaker": "HULL",
   "text": "The exit is locked. The lever on the north wall of this road, near the far lip, unlocks it.",
   "unless": [
    "msg:far-lip"
   ]
  },
  {
   "id": "hollow",
   "at": [20, 7],
   "radius": 3,
   "speaker": "HULL",
   "text": "The wall of the north road rings hollow in one short run, in the first stretch. A hand wide, no more, and dry."
  },
  {
   "id": "cache",
   "at": [20, 2],
   "radius": 3,
   "speaker": "A SILENT (NOTE)",
   "text": "I put this in the wall the winter the crack began. It was a hand wide then. It was a hand wide for a very long time."
  }
 ],
