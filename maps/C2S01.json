 "scenery": [],
 "par": {
  "time": 150
 },
 "intro": {
  "title": "THE SILENT ORCHARD",
  "lines": [
   "Ten beds under a roof of small lights.",
   "Someone has kept them."
  ]
 },
 "outro": "The stair out of the garden comes up beyond the Drowned Choir, in the dark.",
 "messages": [
  {
   "id": "start",
   "at": [35, 57],
   "radius": 4,
   "speaker": "INES",
   "text": "A garden. Ten beds, the paths between them swept, and a roof of small lights. No sound at all, not even from the gate behind me."
  },
  {
   "id": "t1",
   "at": [51, 35],
   "radius": 3.5,
   "speaker": "THE TENDER",
   "text": "You opened the cage. I walked down after you. It is a long way, and I know it, because it is the way the dead are carried. I keep the garden where they are set down."
  },
  {
   "id": "t2",
   "at": [35, 44],
   "radius": 3.5,
   "speaker": "THE TENDER",
   "text": "This garden is the oldest thing here. Ten beds. Seven are for the worlds that were sung before yours. Three I have not named yet."
  },
  {
   "id": "t3",
   "at": [19, 35],
   "radius": 3.5,
   "speaker": "THE TENDER",
   "text": "The ones who sang are in the beds. A Vael cannot be put in the ground alone. So the beds are planted, and the plants are tuned, and the dead are answered."
  },
  {
   "id": "t4",
   "at": [25, 20],
   "radius": 3.5,
   "speaker": "THE TENDER",
   "text": "The count is short. It has been short since the stone cooled. When the count is short they take more voices. That is why they came to your harbour."
  },
  {
   "id": "t5",
   "at": [35, 18],
   "radius": 3.5,
   "speaker": "THE TENDER",
   "text": "You do not hear the Hush. I have watched you walk through three halls. You walk as if nothing has asked you a question. I think that is why you can reach the bottom."
  },
  {
   "id": "t6",
   "at": [45, 20],
   "radius": 3.5,
   "speaker": "THE TENDER",
   "text": "At the bottom is the Root Bell. It is the last voice the stone has. They ring it by hand, and the hands are tired. I will not tell you to stop it. I will tell you that it is tired."
  },
  {
   "id": "t7",
   "at": [51, 27],
   "radius": 3.5,
   "speaker": "THE TENDER",
   "text": "Take what is in the beds. It is oil, pressed from the seed of the chimes. It will light you. Go back up by the stair. I will be here."
  },
  {
   "id": "oil",
   "at": [35, 31],
   "radius": 3,
   "speaker": "HULL",
   "text": "The oil in the tins is pressed from the seed of the chime plants. A tin burns as long as a Marrow tin, and smells of cut grass."
  },
  {
   "id": "exit",
   "at": [35, 8],
   "radius": 3,
   "speaker": "INES",
   "text": "The stair is narrow and goes up in the dark. She did not come to the foot of it to say goodbye. She didn't need to."
  }
 ],
 "objective": "Walk the garden. The beds hold what the keeper left for whoever came",
