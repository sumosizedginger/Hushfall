 "par": {
  "time": 420
 },
 "intro": {
  "title": "GLASS STEPPE",
  "lines": [
   "East of the cliff there was a sea. The floor of it is a plain of glass.",
   "There is one road across."
  ]
 },
 "outro": "Next: the Cantor Outpost. A fort stands in the glass at the far side, with a bell house at its heart.",
 "messages": [
  {
   "id": "start",
   "at": [8, 35],
   "radius": 3,
   "speaker": "INES",
   "text": "East of the cliff the sea bed runs flat to the horizon. Salt, glass, one road. A hundred metres on, the people on it are all facing the same way."
  },
  {
   "id": "queue",
   "at": [20, 35],
   "radius": 4,
   "speaker": "INES",
   "text": "A queue along the road, spaced like fence posts, every one facing east. Nobody is leading it. Nobody is at the back."
  },
  {
   "id": "ridges",
   "at": [34, 35],
   "radius": 4,
   "speaker": "HULL",
   "text": "Glass ridges north and south, and something standing on each. At sixty metres the carbine or the harpoon is the honest answer."
  },
  {
   "id": "canals",
   "at": [30, 28],
   "radius": 4,
   "speaker": "HULL",
   "text": "The canals are two metres under the plain: no line of fire from the ridges, a way up every thirty cells. Gaunts like the dark."
  },
  {
   "id": "plate",
   "at": [20, 12],
   "radius": 2.5,
   "speaker": "RINGING PLATE",
   "text": "A plate of ringing stone. Run a nail down it: twelve notes, then the same twelve. A count, or a name, or both."
  },
  {
   "id": "lever",
   "at": [20, 10],
   "radius": 2,
   "speaker": "HULL",
   "text": "A relay lever: station one of three. The gate at the east end of the road wants all three thrown."
  },
  {
   "id": "relay1",
   "at": [0, 0],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "One of three. A hum comes up through the floor, once, and stops."
  },
  {
   "id": "relay2",
   "at": [0, 0],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "Two of three. The road is lit from underneath for a moment, east to west."
  },
  {
   "id": "relay3",
   "at": [0, 0],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "Three of three. Far to the east, a gate opens that nobody here could have heard."
  },
  {
   "id": "needles",
   "at": [66, 40],
   "radius": 5,
   "speaker": "INES",
   "text": "The needles are nearer from here. At the foot of the nearest there is something taller than the rest, standing very still."
  },
  {
   "id": "log",
   "at": [101, 60],
   "radius": 2.5,
   "speaker": "PELLEW, MATE (LOG)",
   "text": "Eleven left the beach. Nine at the first station. The queue does not look at you; we walked past it. Eight. East is the only road. Do not count."
  },
  {
   "id": "hollow",
   "at": [95, 60],
   "radius": 2,
   "speaker": "HULL",
   "text": "The east wall of this recess rings hollow."
  },
  {
   "id": "gate",
   "at": [0, 0],
   "radius": 0.1,
   "speaker": "INES",
   "text": "Three levers, one gate. Somebody built this road to be crossed one station at a time, and counted."
  }
 ],
 "objective": "Cross the dry sea: three relay stations open the gate at the east end of the road",
