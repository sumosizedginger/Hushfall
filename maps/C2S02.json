 "intro": {
  "title": "INES'S LAMP",
  "lines": [
   "A pier into a sea of glass.",
   "At the end of it a lamp that is lit."
  ]
 },
 "outro": "The pier was the same length going back. Behind you the post was bare, and the lamp in your hand was lit.",
 "messages": [
  {
   "id": "start",
   "at": [19, 38],
   "radius": 4,
   "speaker": "INES",
   "text": "The lamp from the quay, on its post at the end of a pier. The water under the pier is glass, and the lamp is the only thing here that is not."
  },
  {
   "id": "weight",
   "at": [19, 14],
   "radius": 4,
   "speaker": "INES",
   "text": "It is heavier than I remembered. The brass is the same. I filled it that night at the second bell, from the can behind the door."
  },
  {
   "id": "use",
   "at": [19, 11],
   "radius": 3,
   "speaker": "HULL",
   "text": "The lamp hangs on the south face of the post. Taken, it burns without oil, and a ring that reaches whoever carries it lit is cut to two-fifths."
  },
  {
   "id": "taken",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "INES",
   "text": "The Tide-Warden lights it when a boat is out. There is no boat out. I will carry it anyway."
  }
 ],
