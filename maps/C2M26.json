 "par": {
  "time": 600
 },
 "intro": {
  "title": "SILENT ROOTS",
  "lines": [
   "A cave of root columns, and what sleeps among them.",
   "The HUD says how far a shot will carry. The lantern is seen from far off."
  ]
 },
 "outro": "The refectory was a long table laid for forty, and nobody at it. The corridor beyond the table goes on down into the root, and there is a sound at the end of it that is very slow.",
 "messages": [
  {
   "id": "start",
   "at": [8, 90],
   "radius": 5,
   "speaker": "INES",
   "text": "Columns of root as thick as a house, set at irregular distances, and a floor that gives back every step. Something breathes in the dark a long way off, and it is more than one."
  },
  {
   "id": "tell",
   "at": [14, 86],
   "radius": 5,
   "speaker": "HULL",
   "text": "The mark on the screen says how far the gun in your hand carries. The arc lamp, the fork and a blow carry almost nowhere. A lit lantern is seen from far off by whatever sees."
  },
  {
   "id": "west",
   "at": [14, 50],
   "radius": 4,
   "speaker": "A SILENT",
   "text": "I will not say who sleeps by the south chamber. I will say they sleep by the door, and that a quiet hand goes past them."
  },
  {
   "id": "south",
   "at": [50, 84],
   "radius": 4,
   "speaker": "A SILENT",
   "text": "I will not call anyone. I will say the ones in the east keep their eyes on the light. Put the lamp out in the lanes. They hear nothing else."
  },
  {
   "id": "east",
   "at": [84, 50],
   "radius": 4,
   "speaker": "A SILENT",
   "text": "I will not sing. The refectory has forty places and nobody in them. They have come in since the bell: eleven, from the north, in armour."
  },
  {
   "id": "r1",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The west latch is thrown. Somewhere north of here a long wooden bolt has moved a hand."
  },
  {
   "id": "r2",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The south latch is thrown. The same sound as before, a little further to the left."
  },
  {
   "id": "r3",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The east latch is thrown. The bolts all hang free: the refectory gate is open."
  },
  {
   "id": "gate",
   "at": [50, 35],
   "radius": 5,
   "speaker": "HULL",
   "text": "The refectory gate is shut. It is held by three bolts, one from the latch in each of the three chambers of the Silent."
  },
  {
   "id": "refectory",
   "at": [50, 24],
   "radius": 5,
   "speaker": "INES",
   "text": "A table laid for forty with a lamp at every fifth place. They are standing in the gaps. They have been waiting for me to open the door."
  },
  {
   "id": "hollow",
   "at": [35, 78],
   "radius": 3,
   "speaker": "HULL",
   "text": "This column is thicker than the rest, and one run of its south face rings hollow."
  },
  {
   "id": "cache",
   "at": [35, 83],
   "radius": 3,
   "speaker": "A SILENT (NOTE)",
   "text": "A Songkeeper left a reed and a tin in the root. I kept the tin. I have not played the reed and I will not."
  }
 ],
 "objective": "Find the three chambers of the Silent: west, south and east. A latch in each. Gunfire wakes what is in its reach: the arc and a blow are quiet",
