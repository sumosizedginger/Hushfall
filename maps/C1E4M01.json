   "at": [35, 35],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The car is called."
  },
  {
   "id": "panel",
   "at": [26, 31],
   "radius": 3,
   "speaker": "HULL",
   "text": "The panel in the bay wall rings hollow."
  },
  {
   "id": "top",
