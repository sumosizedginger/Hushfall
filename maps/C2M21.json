 },
 "intro": {
  "title": "PULSE FOUNDRY",
  "lines": [
   "Three catwalks round a pit of white light, one above another, and a bell in a body at every turn.",
   "The valves that open the way are where the biggest ones stand."
  ]
 },
 "outro": "The last wheel stopped and the pit went from white to red, and the red went slowly down. On the top ring a door that had been a wall stood open on a stair, and the stair was cold.",
 "messages": [
  {
   "id": "start",
   "at": [7, 50],
   "radius": 5,
   "speaker": "INES",
   "text": "A pit of white light with three catwalks round it, one above another, and a wall between each. The light goes up and down about once every second and a half."
  },
  {
   "id": "steam",
   "at": [12, 42],
   "radius": 6,
   "speaker": "HULL",
   "text": "A steam jet is lit for a beat before it fires. A segment that is dark has just fired and will not again for four seconds."
  },
  {
   "id": "belt",
   "at": [8, 38],
   "radius": 5,
   "speaker": "HULL",
   "text": "The floor of this stretch is a belt. It carries north, stops, carries south, stops. The steam jet at its foot is where south ends."
  },
  {
   "id": "resonant",
   "at": [30, 30],
   "radius": 7,
   "speaker": "INES",
   "text": "Three of them fused at the hip and grown into one body with a skirt of small bells round the waist. The bells ring when something else is near it. Alone, it's slow."
  },
  {
   "id": "ring",
   "at": [30, 25],
   "radius": 6,
   "speaker": "HULL",
   "text": "Its ring comes out of the waist on the beat. A pier of stone stops it, and so does a catwalk above or below it. Keep it away from the others."
  },
  {
   "id": "log",
   "at": [41, 48],
   "radius": 5,
   "speaker": "FOREMAN LOG",
   "text": "FUSED THIS WEEK: 9. Each of the nine was three singers, and the Hive counts them as three. A ring of nine bells is cheaper than twenty-seven voices."
  },
  {
   "id": "ramps",
   "at": [12, 31],
   "radius": 6,
   "speaker": "HULL",
   "text": "The ramps to the middle ring are at the corners, the ramps to the top at the points of the compass. You cannot go straight up."
  },
  {
   "id": "v1",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The first wheel is turned. The pipe beside it goes quiet and the steam on this ring is a shade lower."
  },
  {
   "id": "v2",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The second wheel is turned. The pit is a little less white."
  },
  {
   "id": "v3",
   "at": [1, 1],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The third wheel is turned. The seal on the top ring has let go."
  },
  {
   "id": "exit",
   "at": [41, 48],
   "radius": 4,
   "speaker": "HULL",
   "text": "The exit is sealed by three valves, one on each ring. The wheels are under red lamps, on the walls beside the catwalks.",
   "unless": [
    "msg:v3"
   ]
  },
  {
   "id": "hatch",
   "at": [50, 19],
   "radius": 3,
   "speaker": "HULL",
   "text": "A short run of the retaining wall above the pit rings hollow. There is a hatch in it."
  },
  {
   "id": "cache",
   "at": [50, 18],
   "radius": 3,
   "speaker": "A SILENT (NOTE)",
   "text": "I stoked the pit for a year. Nobody counts what goes into it, and nobody counts what is left out. Take it."
  }
 ],
