 "intro": {
  "title": "THE CHOIR LOFT",
  "lines": [
   "They have been rehearsing for years.",
   "You are the audience."
  ]
 },
 "outro": "Next: the Spore Foundry. What the Choir sings, the Foundry makes.",
 "messages": [
  {
   "id": "start",
   "at": [5, 24],
   "radius": 3,
   "speaker": "SIGNAL HOUSE",
   "text": "Calder, a hall that climbs. I count rows of them standing before the first pews, and more above. Use the pews. Do not walk up the middle."
  },
  {
   "id": "tuned",
   "at": [19, 24],
   "radius": 3,
   "speaker": "INES",
   "text": "Standing in rows like the stops of an organ. Asleep, or what the ship calls asleep. Do what you do near them from behind a pew."
  },
  {
   "id": "ward",
   "at": [32, 24],
   "radius": 3,
   "speaker": "HULL",
   "text": "The tall one with the wheel of bells again. Everything near it takes half. It is behind the rows: go round the end of a pew and put it down."
  },
  {
   "id": "singers",
   "at": [42, 24],
   "radius": 3,
   "speaker": "INES",
   "text": "The rake is open sky from here, and the singers are up on the top tiers. A round that goes past you spoils your aim. Pew to pew. Do not stop in the aisle."
