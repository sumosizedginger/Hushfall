 "intro": {
  "title": "COLD DOCK",
  "lines": [
   "The fleet is parked here, with its doors open to the dark.",
   "Everything you want is on the other side of some air."
  ]
 },
 "outro": "The hatches close. Behind the glass the rest of the fleet hangs in the dark, forty ships and a Gate.",
 "messages": [
  {
   "id": "start",
   "at": [46, 74],
   "radius": 3,
   "speaker": "SIGNAL HOUSE",
   "text": "Calder, the Cold Dock: the Vael parked their fleet here. Two bays are open to the dark and the air in them is gone. A lock lets you in and out, but not both doors at once."
  },
  {
   "id": "hub",
   "at": [46, 51],
   "radius": 3,
   "speaker": "INES",
   "text": "Look at the glass. Ships. Rank on rank of them, hanging. The couplings that start them are in the east and west bays. Seat both at the spine."
  },
  {
   "id": "lock",
   "at": [57, 46],
   "radius": 2.5,
   "speaker": "HULL",
   "text": "Airlock. Open the near door, step in, wait for it to shut and for the air to settle. The far door will not move until it has."
  },
  {
   "id": "dash",
   "at": [66, 46],
   "radius": 3,
   "speaker": "INES",
   "text": "No air. You lose it a second at a time. Do not stop to look."
  },
  {
   "id": "pockets",
   "at": [26, 46],
   "radius": 3,
   "speaker": "SIGNAL HOUSE",
   "text": "The walls are doored closets: pressurised, small, there for the crews. Breathe in one. You cannot be followed through a door."
  },
  {
   "id": "seated",
   "at": [46, 51],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "Both couplings are seated. The north lock is open."
  },
  {
   "id": "panel",
   "at": [46, 20],
   "radius": 3,
   "speaker": "SIGNAL HOUSE",
   "text": "The hatches at the far end are open to the dark. There is a panel on the west wall at the end. It shuts them."
  },
  {
   "id": "air",
   "at": [40, 18],
   "radius": 0.1,
   "speaker": "INES",
   "text": "And the air comes back. I will not say thank you out loud."
  }
 ],
