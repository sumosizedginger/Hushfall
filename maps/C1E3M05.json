 "intro": {
  "title": "RESONANCE LOOM",
  "lines": [
   "The ship tunes the Hush here.",
   "The doors are listening."
  ]
 },
 "outro": "Next: the Choir Loft. The ship has noticed how quiet you are.",
 "messages": [
  {
   "id": "start",
   "at": [5, 28],
   "radius": 3,
   "speaker": "SIGNAL HOUSE",
   "text": "Calder, the Loom. Every door in there listens. Make a noise near one and it will not open for you until it has heard nothing for a while. Kill quietly, or wait."
  },
  {
   "id": "lock",
   "at": [11, 28],
   "radius": 2,
   "speaker": "INES",
   "text": "It is listening. Your own gun is what it hears. Stand still. Count to four. It will let you through."
  },
  {
   "id": "hall",
   "at": [17, 28],
   "radius": 3,
   "speaker": "HULL",
   "text": "A pit, and four floors that rise and fall on a beat, each two seconds behind the last. Step on the first when it is up, the next when it comes up. Or go round, past the singers."
  },
  {
   "id": "east",
   "at": [36, 28],
   "radius": 3,
   "speaker": "INES",
   "text": "Another of the tall ones, a wheel of bells behind it. Whatever stands near it takes half. Kill it first."
  },
  {
   "id": "heart",
   "at": [47, 28],
   "radius": 3,
   "speaker": "SIGNAL HOUSE",
   "text": "Rows of them, standing, asleep: the ones the ship has tuned. If you can cross without a sound, cross. The lever is on the east wall."
  },
  {
   "id": "panel",
   "at": [29, 40],
   "radius": 2,
   "speaker": "HULL",
   "text": "One panel in this wall rings wrong. Hollow, like the others were once."
  },
  {
   "id": "exit",
   "at": [62, 28],
   "radius": 2.5,
   "speaker": "INES",
   "text": "That is the end of the tuning. Whatever was being tuned is still above us, singing."
  }
