 "par": {
  "time": 480
 },
 "intro": {
  "title": "CANTOR OUTPOST",
  "lines": [
   "Five points, a ditch and one bridge.",
   "Something in the middle of it is being kept."
  ]
 },
 "outro": "Next: the Tuning Fork Fields, on the road the Tender named.",
 "messages": [
  {
   "id": "start",
   "at": [46, 91],
   "radius": 3,
   "speaker": "INES",
   "text": "A fort in the glass: five points, a ditch, one bridge. Everything on it faces the gorge. Nobody built it for visitors."
  },
  {
   "id": "terrace",
   "at": [46, 80],
   "radius": 4,
   "speaker": "HULL",
   "text": "Bellhands on both terraces, 4 m up, covering the whole gorge. The rocks are the only cover."
  },
  {
   "id": "bridge",
   "at": [46, 63],
   "radius": 3,
   "speaker": "HULL",
   "text": "The gate is shut. The lever that works it is in the hut on the east terrace, over the ditch. The terrace ramps are at the south end.",
   "unless": [
    "msg:gate"
   ]
  },
  {
   "id": "gate",
   "at": [0, 0],
   "radius": 0.1,
   "speaker": "HULL",
   "text": "The gate grinds open, a hand at a time. Something in the court hears it."
  },
  {
   "id": "court",
   "at": [46, 48],
   "radius": 3,
   "speaker": "INES",
   "text": "A hall with the roof left on and the middle left open to the floor. Five perches, one round keep. This is where they ring things."
  },
  {
   "id": "keep",
   "at": [46, 43],
   "radius": 3,
   "speaker": "INES",
   "text": "Something is shut in the middle of that keep and it isn't one of them. They do not cage their own. Or they do, and I don't know which."
  },
  {
   "id": "latch",
   "at": [46, 32],
   "radius": 2,
   "speaker": "HULL",
   "text": "The latch outside the cage. A cage door has no business with a lever this size."
  },
  {
   "id": "freed",
   "at": [0, 0],
   "radius": 0.1,
   "speaker": "THE TENDER",
   "text": "You do not sing. Good. I keep the dead, and they shut me in the bell house for not singing at a burying. The north gate is mine, and it is open. Go on to the Fields."
  },
  {
   "id": "silent",
   "at": [0, 0],
   "radius": 0.1,
   "speaker": "A SILENT",
   "text": "We stopped. That is the whole of what we did."
  },
  {
   "id": "way",
   "at": [46, 11],
   "radius": 3,
   "speaker": "INES",
   "text": "The Fields, she said. I have not seen a field on this world yet. I don't know what they grow in them."
  },
  {
   "id": "hollow",
   "at": [46, 23],
   "radius": 2,
   "speaker": "HULL",
   "text": "The north wall of the keep rings hollow behind the pillar."
  }
 ],
 "objective": "The gate is shut: its lever is in the hut at the north end of the east terrace",
